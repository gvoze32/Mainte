#!/usr/bin/env sh
# Mainte command-line entry point.

set -eu

# Follow symlinks so ./mainte also works when linked into ~/.local/bin.
mainte_root() {
    _path=$0
    while [ -L "$_path" ]; do
        _link=$(readlink -- "$_path")
        case $_link in
            /*) _path=$_link ;;
            *) _path=$(dirname -- "$_path")/$_link ;;
        esac
    done
    CDPATH='' cd -P -- "$(dirname -- "$_path")" && pwd
}

MAINTE_ROOT=$(mainte_root)
# shellcheck source=lib/common.sh
. "$MAINTE_ROOT/lib/common.sh"

usage() {
    printf '%s\n' \
        'Usage: mainte <command> [options]' \
        '' \
        'Commands:' \
        '  install [--offline]             Install the FiraCode Nerd Font and create mainte.local' \
        '  run [--extensions] [WALLPAPER]  Start (or restart) Mainte' \
        '  reload                          Re-apply mainte.local and layout changes' \
        '  stop                            Stop Mainte' \
        '  layout [show|reset|set ITEM PX] Align the text with your artwork' \
        '  help                            Show this help'
}

command_name=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case $command_name in
    install)
        # shellcheck source=lib/install.sh
        . "$MAINTE_ROOT/lib/install.sh"
        cmd_install "$@"
        ;;
    run|reload|stop)
        # shellcheck source=lib/run.sh
        . "$MAINTE_ROOT/lib/run.sh"
        load_config
        "cmd_$command_name" "$@"
        ;;
    layout)
        # shellcheck source=lib/layout.sh
        . "$MAINTE_ROOT/lib/layout.sh"
        load_config
        cmd_layout "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'mainte: unknown command: %s\n\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac
