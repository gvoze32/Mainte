#!/usr/bin/env sh
# Mainte command dispatcher.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

usage() {
    printf '%s\n' \
        'Usage: ./mainte <command> [options]' \
        '' \
        'Commands:' \
        '  install [--offline|--online]  Prepare Mainte and install the font' \
        '  run [--extensions] [WALLPAPER]  Start Mainte' \
        '  layout [--reset]               Adjust named section positions' \
        '  help                           Show this help'
}

command_name=${1:-help}
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    install)
        exec sh "$SCRIPT_DIR/install.sh" "$@"
        ;;
    run)
        exec "$SCRIPT_DIR/conky-launch.sh" "$@"
        ;;
    layout)
        exec "$SCRIPT_DIR/mainte-layout.sh" "$@"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac
